  m_Script: {fileID: 11500000, guid: e5b0142bf6bc04a4e8538d3cf1ed1699, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TopDogDetective.MainMenu.CutsceneController
  image: {fileID: 1405790891}
  dialogueText: {fileID: 2095960754}
  nextButton: {fileID: 645155796}
  frames:
  - {fileID: -6525251533827417197, guid: 748872c273dd8fc49b64f391584ad3c5, type: 3}
  - {fileID: -154269249030348198, guid: a3d9324f6c637ce43817c453fb612df8, type: 3}
  - {fileID: -7465307106225235979, guid: 16097cb3b5c31d5479b2fd4842ec1cd6, type: 3}
  - {fileID: -7083523246791027351, guid: e1cc2d6ac479ff742bb4609ef76406a6, type: 3}
  lines:
  - "\uACE0\uC591\uC774 \uBC94\uC8C4\uC870\uC9C1\uC774 \uB3C4\uC2DC\uB97C \uC190\uC5D0
    \uB123\uC5C8\uB2E4.\n\uADF8\uB9AC\uACE0 \uB3C4\uC2EC \uD55C\uBCF5\uD310\uC5D0,
    \uAC70\uB300\uD55C \uD3ED\uD0C4\uC744 \uC2EC\uC5C8\uB2E4."
  - "\uD574\uC81C \uCF54\uB4DC\uB294 \uB2E8 \uC138 \uC790\uB9AC.\n\uC870\uC9C1\uC740
    \uADF8\uAC83\uC744 \uC138 \uBA85\uC5D0\uAC8C \uD55C \uC790\uB9AC\uC529 \uCABC\uAC1C
    \uB9E1\uAE30\uACE0, \uBAA8\uB450\uC5D0\uAC8C \uD568\uAD6C\uB839\uC744 \uB0B4\uB838\uB2E4."
  - "\uB098\uB294 \uC870\uC9C1\uC6D0\uC73C\uB85C \uC704\uC7A5\uD574 \uC7A0\uC785\uD55C
    \uAC1C \uACBD\uCC30 \u2014 \uACAC\uCC30\uC774\uB2E4.\n\uC815\uCCB4\uAC00 \uB4DC\uB7EC\uB098\uB294
    \uC21C\uAC04, \uC791\uC804\uC740 \uB05D\uB09C\uB2E4."
  - "\uC740\uC2E0\uCC98\uB97C \uB4A4\uC838 \uC57D\uC810\uC744 \uCC3E\uACE0, \uC9E7\uC740
    \uC124\uB4DD\uC73C\uB85C \uCF54\uB4DC\uB97C \uD558\uB098\uC529 \uBE7C\uB0B8\uB2E4.\n\uC704\uC7A5
    \uC18D\uC5D0 \uC2A4\uBBFC \uC815\uC740\u2026 \uB9C8\uC9C0\uB9C9 \uC21C\uAC04\uC5D0
    \uB3CC\uC544\uC628\uB2E4."
  fadeGroup: {fileID: 1932543870}
  fadeDuration: 0.35
  fadeInOnStart: 0
  nextScreen: {fileID: 1523925499}
